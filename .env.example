# ── required ──────────────────────────────────────────────
BOT_TOKEN=123456:your_token_from_BotFather

# ── recommended ───────────────────────────────────────────
ADMIN_ID=                    # your Telegram user id (comma-separated for several) → enables /admin and /broadcast
GEMINI_API_KEY=              # free key from https://aistudio.google.com — best translation quality (LLM, context-aware)

# ── optional ──────────────────────────────────────────────
GEMINI_MODEL=gemini-flash-latest
ENGINE_ORDER=gemini,google,libre,mymemory    # engines are tried left → right; unavailable ones are skipped
LIBRETRANSLATE_URL=          # e.g. your own LibreTranslate instance
LIBRETRANSLATE_API_KEY=
MYMEMORY_EMAIL=              # raises MyMemory's free daily quota
DATA_DIR=data                # where botam.db lives. On Render use a persistent disk path (e.g. /var/data)
PORT=10000
MAX_CHARS=4000
RATE_LIMIT_COUNT=6
RATE_LIMIT_WINDOW=20
LOG_LEVEL=INFO
